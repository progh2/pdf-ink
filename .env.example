# 구글 드라이브 (#133). 둘 다 브라우저에 노출되는 공개값이라 시크릿이 아니다.
# 보호는 "감추기"가 아니라 origin·리퍼러 제한으로 한다.
#
# 로컬에서 쓰려면 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 커밋되지 않는다).
# 배포에서는 Vercel 프로젝트 환경변수에 같은 이름으로 넣고 재배포한다.
#
# 클라이언트 ID: Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
#   승인된 JavaScript 원본: https://pdf-ink.vercel.app, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# API 키: 같은 화면 → API 키. 키 제한에서
#   애플리케이션 제한: HTTP 리퍼러 → https://pdf-ink.vercel.app/*, http://localhost:5173/*
#   API 제한: Google Picker API
VITE_GOOGLE_API_KEY=

# 드롭박스(#82)는 App key가 코드에 기본값으로 들어 있고, 필요하면 여기서 덮어쓴다.
VITE_DROPBOX_APP_KEY=
